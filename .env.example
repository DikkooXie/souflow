# 复制成 .env 后按本机需要修改。进程已有的环境变量优先。
SOULFLOW_DEMO_PORT=4173
SOULFLOW_DEMO_MAX_CONCURRENT=24
SOULFLOW_CODEX_MAX_CONCURRENT=4
SOULFLOW_DISPATCH_MAX_CONCURRENT=2
SOULFLOW_DISPATCH_TICKET_OUTPUT_MAX_BYTES=131072
# 可选。调度面板的本机名称，默认使用操作系统主机名。
# SOULFLOW_HOST_NAME=

# 可选。工作台页面仍在本机访问。证书应包含绑定地址的 IP SAN，私钥只放在主机。
# 设备走 Tailscale 时，绑定主机的 tailscale ip -4。
# SOULFLOW_LAN_BIND=
# SOULFLOW_LAN_PORT=4717
# SOULFLOW_LAN_CERT_FILE=
# SOULFLOW_LAN_KEY_FILE=
# SOULFLOW_LAN_OFFLINE_MS=8000

# 留空时使用本机 Codex 的默认模型。可分别设置规划与命令执行模型。
# SOULFLOW_CODEX_PLANNING_MODEL=gpt-6.2-astra
# SOULFLOW_CODEX_EXECUTION_MODEL=gpt-6.2-sol

# 可选。每个执行账号使用独立的本机 Codex 登录目录，别名可显示。并发上限按账号生效。
# SOULFLOW_CODEX_ACCOUNTS_JSON=[{"label":"primary","directory":"/absolute/path/to/first-login","concurrency":2},{"label":"secondary","directory":"/absolute/path/to/second-login","concurrency":1}]
# SOULFLOW_CODEX_ACCOUNT_REFRESH_MS=30000
# SOULFLOW_CODEX_ACCOUNT_PROBE_MS=10000
# SOULFLOW_CODEX_ACCOUNT_WAIT_MS=60000
# SOULFLOW_CODEX_ACCOUNT_COOLDOWN_MS=60000

# 可选。提交需求时读取当前 Git 提交里的计划和同一仓库的近期 PR。
# SOULFLOW_PROJECT_PLAN=docs/requirements-workflow.md
# SOULFLOW_PROJECT_GITHUB_REPO=owner/repository

# 需求与自定义答复的输入长度。设置可用的范围为 1 到 16000。
SOULFLOW_PROMPT_MAX_LENGTH=4000
SOULFLOW_ANSWER_MAX_LENGTH=1000

# 留空时，演示和 Codex 模式分别使用 .souflow 下的各自数据库。Codex 模式同库保存恢复状态。
SOULFLOW_AUDIT_DB=

# 审计计时窗口以毫秒为单位，线索提示阈值以次数为单位。
SOULFLOW_AUDIT_REPEAT_CLICK_MS=2000
SOULFLOW_AUDIT_QUICK_RETURN_MS=30000
SOULFLOW_AUDIT_INSIGHT_MIN_COUNT=3

# 按需提供给 Codex 进程使用的环境变量。只在本机 .env 填写真实值。
# OPENAI_API_KEY=

# 两位成员共用本机 Codex 工作台时配置两个不同的随机登录密钥。
# 登录用户名分别为 implementer 和 reviewer。个人模式请使用另一份数据库。
# SOULFLOW_MEMBER_IMPLEMENTER_KEY=
# SOULFLOW_MEMBER_REVIEWER_KEY=

# GitHub 认领需 Codex 模式、持久化数据库、已登录的 gh 以及与 origin 匹配的 SOULFLOW_PROJECT_GITHUB_REPO。
# SOULFLOW_GITHUB_CLAIMS=1
# 可选。将工作台登录名绑定到本机 gh 已连接的账号。配置后仅映射中的实施成员可认领。
# SOULFLOW_GITHUB_ACCOUNTS={"implementer":"github-login","colleague":"another-login"}
# 如需第二个实施成员，在上方双成员模式基础上添加独立随机登录密钥。
# SOULFLOW_MEMBER_IMPLEMENTERS_JSON={"colleague":"替换为独立的随机凭据"}

# 可选。对话选择的 GitHub 工单先通过派发前质量校验，再由成员授权。
# 需连接有写权限的 GitHub 账号，使用已登录的本机 Codex，并准备本机 Docker 检查镜像。
# SOULFLOW_GITHUB_CHECK_IMAGE=node:22.17.1
# SOULFLOW_GITHUB_POLL_MS=20000
SOULFLOW_GITHUB_DELIVERY_TIMEOUT_MS=300000

# 从对话读取项目计划并选择 GitHub 工单。启用后在待决策逐次授权，无需静态工单计划。
# SOULFLOW_GITHUB_CONVERSATION_DELIVERY=1

# 可选。主机允许已登记的指定设备执行代码工单，多个设备 ID 以英文逗号分隔。
# SOULFLOW_CODE_DEVICE_IDS=
# 双机两端使用一致的协议配置。大小以字节计，时间以毫秒计。
SOULFLOW_CODE_WORKER_WAIT_MS=20000
SOULFLOW_CODE_WORKER_HTTP_TIMEOUT_MS=25000
SOULFLOW_CODE_WORKER_OFFLINE_MS=40000
SOULFLOW_CODE_WORKER_MESSAGE_MAX_BYTES=2097152
SOULFLOW_CODE_WORKER_WAIT_BODY_MAX_BYTES=4096
SOULFLOW_CODE_WORKER_MAX_SLOTS=6
SOULFLOW_CODE_WORKER_MAX_UPSTREAM=24
SOULFLOW_CODE_WORKER_MAX_FILES=16
SOULFLOW_CODE_WORKER_INSTRUCTIONS_MAX_LENGTH=12000
SOULFLOW_CODE_WORKER_CONTEXT_MAX_BYTES=917504
# 重试间隔由执行设备读取。状态面板配置由主机读取。
SOULFLOW_CODE_WORKER_RETRY_MS=1500
SOULFLOW_CODE_WORKER_RECENT_ATTEMPTS=32
SOULFLOW_CODE_WORKER_ACTIVITY_MS=3000
# 每台设备独立配置仓库和执行位。镜像和执行模型沿用上面的同名项。
# SOULFLOW_CODE_WORKER_REPO=owner/repository
SOULFLOW_CODE_WORKER_SLOTS=1
SOULFLOW_CODE_WORKER_ROOT=.souflow/code-device
# SOULFLOW_CODE_WORKER_ENROLLMENT_FILE=/absolute/path/to/device.json

# 维护者按原授权续修指定 PR 的一次性参数。提交需为 PR 当前头，文件须属于原授权。
# SOULFLOW_GITHUB_REVIEW_FIX={"issue":1,"pull":2,"head":"0000000000000000000000000000000000000000","base":"main","files":["src/example.mts"],"instructions":"评审修复要求"}
# 仅在受控恢复中指定一张尚未发布的旧版失败工单。写入重试记录后从启动配置移除。
# SOULFLOW_GITHUB_RECOVER_FAILED_ISSUE=
