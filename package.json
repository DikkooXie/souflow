{
  "name": "souflow",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.1"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/workbench/demo-server.mts",
    "dev:codex": "node --experimental-strip-types src/workbench/demo-server.mts --codex",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings src tests",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.mts\"",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.17.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "markdown-it": "15.0.3"
  }
}
